# Environment Variables - Library Study Tracker Frontend
# Vite only exposes variables that start with VITE_. Anything here is public in the browser
# bundle, so never put secrets in this file.

# API base path. Production builds IGNORE this and always use the relative "/api", which
# Vercel proxies to the backend (see vercel.json) so the login cookie is first-party.
# For local development leave it as "/api": the Vite dev server proxies it to http://localhost:5000.
VITE_API_URL=/api

# Where to send API calls from the frontend's Vercel rewrite is NOT set here: edit the
# "destination" in frontend/vercel.json to your backend URL.
