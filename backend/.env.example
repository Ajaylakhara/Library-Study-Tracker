# Environment Variables - Library Study Tracker Backend

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Connection string placeholder for MongoDB Atlas:
# IMPORTANT:
# - Do NOT include angle brackets < > in your real values.
# - The database name (e.g. /library_study_tracker) must come immediately after the cluster host before the query parameters.
# - If your password contains special characters (@, #, /, :, ?, %), URL-encode them (e.g. ? becomes %3F) or set an alphanumeric password in Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
ADMIN_JWT_EXPIRES_IN=1d
STUDENT_JWT_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Seed Admin ──────────────────────────────────────────────────────────────
# Max login/register attempts per IP per 15 min
AUTH_RATE_LIMIT_MAX=20
ADMIN_NAME=Librarian
ADMIN_PHONE=9000000000
ADMIN_PIN=
# Default monthly fee applied when approving a student from Telegram; 0 disables fee generation.
DEFAULT_MONTHLY_FEE=0

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
PUBLIC_URL=https://your-public-domain.example

# ─── Notifications ───────────────────────────────────────────────────────────
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
ADMIN_ALERT_PHONE=9000000000

# ─── MSG91 (if SMS_PROVIDER=msg91) ───────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LIBSMS
MSG91_DLT_TEMPLATE_APPROVED=
MSG91_DLT_TEMPLATE_REJECTED=
MSG91_DLT_TEMPLATE_SHIFT_REMINDER=
MSG91_DLT_TEMPLATE_SHIFT_ENDED=
MSG91_DLT_TEMPLATE_AUTO_CHECKOUT=
MSG91_DLT_TEMPLATE_FEE_UNPAID=
MSG91_DLT_TEMPLATE_OVERTIME_ADMIN=
MSG91_DLT_TEMPLATE_FEE_GENERATED_ADMIN=

# ─── Meta WhatsApp Cloud API (if WHATSAPP_PROVIDER=meta) ─────────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_VERSION=v19.0

# DEV ONLY: skip login (ignored when NODE_ENV=production)
DEV_AUTH_BYPASS=false
