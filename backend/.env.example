# Environment Variables - Library Study Tracker Backend
# Copy to .env for local work. On Vercel, set every variable in Project Settings ->
# Environment Variables (Production) and redeploy. Never commit real values.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
# Vercel sets NODE_ENV=production by itself. In production the server refuses to start
# without a strong JWT_SECRET.
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# IMPORTANT:
# - Do NOT include angle brackets < > in your real values.
# - The database name (e.g. /library_study_tracker) must come immediately after the cluster host before the query parameters.
# - If your password contains special characters (@, #, /, :, ?, %), URL-encode them (e.g. ? becomes %3F) or set an alphanumeric password in Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Tests only. Must be a separate database whose name ends in _test (never your live data).
MONGODB_TEST_URI=

# ─── Login / session ─────────────────────────────────────────────────────────
# REQUIRED. At least 32 random characters; there is no fallback value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_random_hex_characters
# The origin the browser loads the app from (used for CORS during local development).
# In production the frontend reaches /api through the Vercel proxy, so this is not what sets the cookie.
CLIENT_URL=http://localhost:5173
# Max login/register requests per IP per 15 minutes. (Wrong PINs are limited separately:
# 5 per phone number then a 15-minute lock, and 30 per IP.)
AUTH_RATE_LIMIT_MAX=20

# ─── Background jobs (overtime alerts, notification delivery) ────────────────
# REQUIRED on Vercel: random secret the minute scheduler sends as "Authorization: Bearer <secret>".
# Generate it the same way as JWT_SECRET.
CRON_SECRET=replace_with_a_random_cron_secret
# false on Vercel/serverless (an external scheduler calls POST /api/cron/tick every minute).
# true on one always-on server (jobs run inside the process; run a single instance only).
RUN_JOBS_IN_PROCESS=true
# Minutes between repeat overtime alerts to the admin. 0 = no repeats. At most 6 repeats per session.
OVERTIME_REPEAT_MINUTES=0

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Random string; Telegram sends it back on every webhook call so the server can verify the sender.
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret
# Public HTTPS address of THIS backend (used by `npm run telegram:set-webhook`).
PUBLIC_URL=https://your-backend.example

# ─── Seed admin (npm run seed) ───────────────────────────────────────────────
ADMIN_NAME=Librarian
ADMIN_PHONE=9000000000
ADMIN_PIN=
# Default monthly fee applied when approving a student from Telegram; 0 disables fee generation.
DEFAULT_MONTHLY_FEE=0
DEFAULT_COUNTRY_CODE=+91

# ─── Notifications ───────────────────────────────────────────────────────────
# Required for signed SMS reminder helper links; use a random secret of at least 32 characters.
SMS_ACTION_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
ADMIN_ALERT_PHONE=9000000000

# ─── MSG91 (if SMS_PROVIDER=msg91) ───────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_SENDER_ID=LIBSMS
MSG91_DLT_TEMPLATE_APPROVED=
MSG91_DLT_TEMPLATE_REJECTED=
MSG91_DLT_TEMPLATE_SHIFT_REMINDER=
MSG91_DLT_TEMPLATE_SHIFT_ENDED=
MSG91_DLT_TEMPLATE_AUTO_CHECKOUT=
MSG91_DLT_TEMPLATE_FEE_UNPAID=
MSG91_DLT_TEMPLATE_OVERTIME_ADMIN=
MSG91_DLT_TEMPLATE_FEE_GENERATED_ADMIN=

# ─── Meta WhatsApp Cloud API (if WHATSAPP_PROVIDER=meta) ─────────────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_VERSION=v19.0

# DEV ONLY: skip login (ignored when NODE_ENV=production)
DEV_AUTH_BYPASS=false
